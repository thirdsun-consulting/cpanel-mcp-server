{
  "name": "cpanel-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for cPanel UAPI — per-account operations: email, databases, cron, domains, files, SSL, PHP, error logs",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cpanel-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && chmod +x dist/index.js",
    "clean": "rm -rf dist",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "verify:mock": "node scripts/verify-mock.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["mcp", "cpanel", "uapi", "anthropic", "claude"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
